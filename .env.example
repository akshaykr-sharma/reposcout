# Copy this file to .env and edit. .env is git-ignored.

# --- Which model runs the agent ------------------------------------------
# A model is written as  provider:model-name
#   ollama:qwen2.5:7b            local, free, private (default; needs `ollama serve`)
#   anthropic:claude-sonnet-5-5  Claude - needs ANTHROPIC_API_KEY
#   google:gemini-2.5-flash      Gemini - needs GOOGLE_API_KEY (or GEMINI_API_KEY)
#   anthropic / google           just the provider = its default model
# Leave empty to use the local Ollama model below.
# NOTE: with Claude or Gemini, the code the agent reads is sent to that provider.
# Credential files (.env, keys) are always blocked from the agent.
REPOSCOUT_MODEL=

# Optional: a different model per role (same format). Empty = use REPOSCOUT_MODEL.
# Example for speed + quality: fast analysts, strong writer.
#   REPOSCOUT_ANALYST_MODEL=google:gemini-2.5-flash
#   REPOSCOUT_WRITER_MODEL=anthropic:claude-sonnet-5-5
REPOSCOUT_ANALYST_MODEL=
REPOSCOUT_WRITER_MODEL=
# Evals only: grade answers with a DIFFERENT model than the one answering
REPOSCOUT_JUDGE_MODEL=

# --- API keys (only for the providers you use) -----------------------------
# Install the client once:  pip install -e ".[cloud]"   (or .[anthropic] / .[google])
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Local model (Ollama) ---------------------------------------------
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# Ollama's default context is tiny; deep agents need more room (Ollama only)
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.1

# --- What to study ------------------------------------------------------
# Folder of the code RepoScout reads (read only). Defaults to this project.
# Windows example: C:\Users\you\code\my-project
REPOSCOUT_REPO_PATH=
# Where the onboarding pack is written (default: ./output/docs)
REPOSCOUT_DOCS_DIR=
# Extra folder names to skip, comma separated
REPOSCOUT_IGNORE=

# --- LangSmith (free Developer plan, never add a card) -------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reposcout
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
